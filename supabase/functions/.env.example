URL=https://your-project-id.supabase.co
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key
REPORT_EXPORT_BUCKET=report-exports

# Used by approval-notifications when called from DB/webhook automation
APPROVAL_NOTIFICATION_WEBHOOK_SECRET=replace-with-a-long-random-secret
REPORT_EXPORT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Outbound email provider for approval-notifications.
# Use EMAIL_PROVIDER=resend in production. EMAIL_API_URL is optional for Resend
# and defaults to https://api.resend.com/emails when blank.
EMAIL_PROVIDER=resend
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Optional QA fixture IDs for npm run qa:notifications.
KPI_DEFINITION_VERSION_ID=
KPI_TARGET_VERSION_ID=
PROBATION_REVIEW_ID=
PIP_PLAN_ID=
